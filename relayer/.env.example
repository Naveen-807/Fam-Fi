# Monad testnet
RPC_URL=https://testnet-rpc.monad.xyz
# Pays gas for every relayed request. Fund with MON from https://faucet.monad.xyz
RELAYER_KEY=
# Holds the testnet USDC collected from Circle's faucet; funds users via depositFor. Needs a little MON too.
TREASURY_KEY=
FAMFI_ADDRESS=
FORWARDER_ADDRESS=
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Comma-separated list, or * for any
ALLOWED_ORIGIN=*
FAUCET_AMOUNT=5
FAUCET_COOLDOWN_HOURS=24
PORT=8787
# Envio GraphQL endpoint for the authenticated /private/query reads (Passport, Weekly Brief, Inbox, FutureFund)
ENVIO_URL=
# Optional setup action; leave false for normal starts (no automatic token approval).
PREPARE_TREASURY_ALLOWANCE=false
CONTRACT_VERSION=v1
