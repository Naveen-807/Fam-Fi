# Monad testnet defaults. Copy to .env.local and fill in the deployed addresses.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_FAMFI=
NEXT_PUBLIC_FORWARDER=
NEXT_PUBLIC_USDC=0x534b2f3A21130d7a60830c2Df862319e593943A3
NEXT_PUBLIC_RELAYER_URL=
# Envio GraphQL endpoint (HTTP) and, for live subscriptions, its WebSocket endpoint
NEXT_PUBLIC_ENVIO_URL=
NEXT_PUBLIC_ENVIO_WS=
NEXT_PUBLIC_EXPLORER_TX=https://testnet.monadvision.com/tx/
NEXT_PUBLIC_NETWORK_LABEL=Monad testnet
# Required: your Dynamic environment ID, for real email + passkey login.
NEXT_PUBLIC_DYNAMIC_ENV_ID=
